# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values. Without a key, that part of the app runs in demo mode.

# Writes the story (required for real play). From console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Draws pictures and video clips. From replicate.com → Account → API tokens.
REPLICATE_API_TOKEN=

# Keeps pictures and clips permanently. Created for you when you add a
# Vercel Blob store to the project (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=

# Beta gate: players must enter this code before anything that costs money runs.
# Leave empty only if you want the app fully open.
BETA_CODE=

# Lets you open /admin.html to pre-draw shared art and test models.
ADMIN_CODE=

# Signs media job tokens. Any long random string.
APP_SECRET=

# Optional overrides (defaults shown).
# STORY_MODEL=claude-sonnet-5-5
# STORY_MODEL_FAST=claude-haiku-5-5
# IMAGE_MODEL=black-forest-labs/flux-2-pro
# SHEET_MODEL=black-forest-labs/flux-kontext-pro
# VIDEO_MODEL=minimax/h3-lite
# VIDEO_DURATION=6
